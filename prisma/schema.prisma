  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  userAgent   String?  @map("user_agent") @db.Text

  changedByUser User? @relation("AuditCreator", fields: [changedBy], references: [id])

  @@index([entityType, entityId])
  @@index([changedBy])
  @@index([changedAt])
  @@index([entityType, changedAt])
  @@map("audit_log")
}

// ─── THESSBUDDY: RAW SALES ──────────────────────────────────────────────────

model RawSales {
