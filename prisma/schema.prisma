  allocatedToUserName String? @map("allocated_to_user_name") @db.VarChar(200)
  allocatedToBranch String?   @map("allocated_to_branch") @db.VarChar(50)
  status            String    @default("AVAILABLE") @db.VarChar(50) // AVAILABLE, ALLOCATED, MAINTENANCE, DISPOSED
  serialNumber      String?   @map("serial_number") @db.VarChar(150)
  modelNumber       String?   @map("model_number") @db.VarChar(150)
  specifications    String?   @db.Text
  purchaseDate      DateTime? @map("purchase_date")
  purchaseCost      Float?    @default(0.0) @map("purchase_cost")
  currentValue      Float?    @default(0.0) @map("current_value")
  billNumber        String?   @map("bill_number") @db.VarChar(100)
  vendorName        String?   @map("vendor_name") @db.VarChar(200)
  warrantyExpiry    DateTime? @map("warranty_expiry")
  amcExpiry         DateTime? @map("amc_expiry")
  insuranceExpiry   DateTime? @map("insurance_expiry")
  barcode           String?   @db.VarChar(100)
  qrCode            String?   @map("qr_code") @db.VarChar(255)
  depreciationRate  Float     @default(0.0) @map("depreciation_rate")
