// ─── CASH MANAGEMENT ─────────────────────────────────────────────────────────

model CashTransaction {
  id                   String              @id @default(uuid()) @db.Uuid
  transactionType      CashTransactionType @map("transaction_type")
  branchCode           String              @map("branch_code") @db.VarChar(20)
  partyId              String?             @map("party_id") @db.Uuid
  costCenter           String?             @map("cost_center") @db.VarChar(50)
  amount               Decimal             @db.Decimal(18, 2)
  transactionDate      DateTime            @map("transaction_date")
  referenceNo          String?             @map("reference_no") @db.VarChar(100)
  description          String?             @db.Text
  reconciliationStatus ReconciliationStatus @default(UNRECONCILED) @map("reconciliation_status")
  reconciledWithId     String?             @map("reconciled_with_id") @db.Uuid
  reconciledAt         DateTime?           @map("reconciled_at")
  rowVersion           Int                 @default(1) @map("row_version")
  createdAt            DateTime            @default(now()) @map("created_at")
  createdBy            String?             @map("created_by") @db.Uuid
  updatedAt            DateTime            @updatedAt @map("updated_at")
  updatedBy            String?             @map("updated_by") @db.Uuid

  branch       Branch            @relation(fields: [branchCode], references: [code])
  party        Party?            @relation(fields: [partyId], references: [id])
  reconciledWith RawStagingRecord? @relation("CashReconciliation", fields: [reconciledWithId], references: [id])
  workflowInstances WorkflowInstance[]

  @@index([branchCode, transactionDate])
  @@index([branchCode, reconciliationStatus, transactionDate])
  @@index([partyId, transactionDate])
  @@index([reconciliationStatus])
  @@index([costCenter, transactionDate])
  @@map("cash_transactions")
}

// ─── RETAIL SALES UPLOAD ─────────────────────────────────────────────────────

model RetailSalesRecord {
  id                String   @id @default(uuid()) @db.Uuid
  uploadBatchId     String   @map("upload_batch_id") @db.VarChar(100)

  // Core identifiers from Excel
  consignee         String   @db.VarChar(50)
  dealerCode        String   @map("dealer_code") @db.VarChar(20)
  loc               String?  @db.VarChar(20)
  partCategoryCode  String?  @map("part_category_code") @db.VarChar(20)
  partNum           String   @map("part_num") @db.VarChar(100)
  rootPartNum       String?  @map("root_part_num") @db.VarChar(100)
  day               String?  @db.VarChar(5)
  fiscalYear        Int?     @map("fiscal_year")
  month             String?  @db.VarChar(20)
  monthYear         String   @map("month_year") @db.VarChar(20)  // e.g. "Jun 2026"
  consPartyCode     String?  @map("cons_party_code") @db.VarChar(50)
  consPartyName     String?  @map("cons_party_name") @db.VarChar(200)
  partyType         String?  @map("party_type") @db.VarChar(100)
  documentNum       String   @map("document_num") @db.VarChar(100)
  remarks           String?  @db.VarChar(500)

  // Metrics
  netRetailQty      Decimal? @map("net_retail_qty") @db.Decimal(18, 4)
  netRetailSelling  Decimal? @map("net_retail_selling") @db.Decimal(18, 4)
  discountAmount    Decimal? @map("discount_amount") @db.Decimal(18, 4)
  netRetailDdl      Decimal? @map("net_retail_ddl") @db.Decimal(18, 4)

  // Metadata
  createdAt         DateTime @default(now()) @map("created_at")
  createdBy         String?  @map("created_by") @db.Uuid
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([consignee, dealerCode, partNum, documentNum, monthYear])
  @@index([dealerCode, monthYear])
  @@index([uploadBatchId])
  @@index([monthYear])
  @@index([consignee, monthYear])
  @@index([consPartyCode, monthYear])
  @@index([fiscalYear, month])
  @@index([loc, monthYear])
  @@index([consPartyCode, fiscalYear])
  @@map("retail_sales_records")
}

model RetailSalesUploadLog {
  id            String   @id @default(uuid()) @db.Uuid
  batchId       String   @unique @map("batch_id") @db.VarChar(100)
  fileName      String   @map("file_name") @db.VarChar(500)
  monthYear     String   @map("month_year") @db.VarChar(500)  // period this upload covers
  totalRows     Int      @map("total_rows")
  insertedRows  Int      @map("inserted_rows") @default(0)
  deletedRows   Int      @map("deleted_rows") @default(0)
  status        String   @db.VarChar(20) // PROCESSING, DONE, FAILED
  errorMessage  String?  @map("error_message") @db.Text
  createdAt     DateTime @default(now()) @map("created_at")
  createdBy     String?  @map("created_by") @db.Uuid
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([monthYear])
  @@index([createdBy, createdAt])
  @@map("retail_sales_upload_logs")
}

// ─── RAW STAGING RECORD (unified for all imports) ────────────────────────────

model RawStagingRecord {
  id            String       @id @default(uuid()) @db.Uuid
  sourceType    String       @map("source_type") @db.VarChar(50) // BANK_STATEMENT, EXTERNAL_INCENTIVE, GENERIC
  batchId       String       @map("batch_id") @db.Uuid
  status        ImportStatus
  amount        Decimal?     @db.Decimal(18, 2)
  transactionDate DateTime?  @map("transaction_date")
  referenceNo   String?      @map("reference_no") @db.VarChar(200)
  partyCode     String?      @map("party_code") @db.VarChar(50)
  branchCode    String?      @map("branch_code") @db.VarChar(20)
  payload       Json?        // source-specific fields
  validationErrors Json?     @map("validation_errors")
  errorMessage  String?      @map("error_message") @db.Text
  committedEntityId String?  @map("committed_entity_id") @db.Uuid
  committedEntityType String? @map("committed_entity_type") @db.VarChar(50)
  committedAt   DateTime?    @map("committed_at")
  rolledBackAt  DateTime?    @map("rolled_back_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  createdBy     String?      @map("created_by") @db.Uuid
  updatedAt     DateTime     @updatedAt @map("updated_at")
  updatedBy     String?      @map("updated_by") @db.Uuid

  importLog                  ImportLog?        @relation(fields: [batchId], references: [batchId])
