// ─── WORKFLOW ENGINE ─────────────────────────────────────────────────────────

model WorkflowDefinition {
  id          String              @id @default(uuid()) @db.Uuid
  code        String              @unique @db.VarChar(100)
  name        String              @db.VarChar(200)
  entityType  WorkflowEntityType  @map("entity_type")
  description String?             @db.Text
  isActive    Boolean             @default(true) @map("is_active")
  createdAt   DateTime            @default(now()) @map("created_at")
  createdBy   String?             @map("created_by") @db.Uuid
  updatedAt   DateTime            @updatedAt @map("updated_at")
  updatedBy   String?             @map("updated_by") @db.Uuid

  steps     WorkflowStep[]
  instances WorkflowInstance[]

  @@index([entityType, isActive])
  @@map("workflow_definitions")
}

model WorkflowStep {
  id                 String             @id @default(uuid()) @db.Uuid
  workflowDefinitionId String           @map("workflow_definition_id") @db.Uuid
  stepNumber         Int                @map("step_number")
  name               String             @db.VarChar(200)
  stepType           WorkflowStepType   @map("step_type")
  assigneeType       String?            @map("assignee_type") @db.VarChar(50) // ROLE, USER, DYNAMIC
  assigneeValue      String?            @map("assignee_value") @db.VarChar(200)
  timeoutHours       Int?               @map("timeout_hours")
  isRequired         Boolean            @default(true) @map("is_required")
  conditionExpression String?           @map("condition_expression") @db.Text
  createdAt          DateTime           @default(now()) @map("created_at")
  createdBy          String?            @map("created_by") @db.Uuid
  updatedAt          DateTime           @updatedAt @map("updated_at")
  updatedBy          String?            @map("updated_by") @db.Uuid

  workflowDefinition WorkflowDefinition @relation(fields: [workflowDefinitionId], references: [id], onDelete: Cascade)
  assignments        WorkflowStepAssignment[]
  histories          WorkflowStepHistory[]

  @@unique([workflowDefinitionId, stepNumber])
  @@map("workflow_steps")
}

model WorkflowInstance {
  id                   String                @id @default(uuid()) @db.Uuid
  workflowDefinitionId String                @map("workflow_definition_id") @db.Uuid
  entityType           WorkflowEntityType    @map("entity_type")
  entityId             String                @map("entity_id") @db.Uuid
  status               WorkflowInstanceStatus @default(IN_PROGRESS)
  currentStepNumber    Int                   @map("current_step_number") @default(1)
  initiatedBy          String                @map("initiated_by") @db.Uuid
  completedAt          DateTime?             @map("completed_at")
  createdAt            DateTime              @default(now()) @map("created_at")
  createdBy            String?               @map("created_by") @db.Uuid
  updatedAt            DateTime              @updatedAt @map("updated_at")
  updatedBy            String?               @map("updated_by") @db.Uuid

  workflowDefinition WorkflowDefinition @relation(fields: [workflowDefinitionId], references: [id])
  incentiveRecords   IncentiveRecord[]  @relation
  cashTransactions   CashTransaction[]  @relation
  stepHistories      WorkflowStepHistory[]
  stepAssignments    WorkflowStepAssignment[]

  @@index([entityType, entityId])
  @@index([status])
  @@index([initiatedBy])
  @@map("workflow_instances")
}

model WorkflowStepAssignment {
  id                   String              @id @default(uuid()) @db.Uuid
  workflowInstanceId   String              @map("workflow_instance_id") @db.Uuid
  workflowStepId       String              @map("workflow_step_id") @db.Uuid
  assignedTo          String              @map("assigned_to") @db.Uuid
  status              WorkflowStepStatus  @default(PENDING)
  remarks             String?             @db.Text
  actedAt             DateTime?           @map("acted_at")
  createdAt           DateTime            @default(now()) @map("created_at")
  createdBy           String?             @map("created_by") @db.Uuid
  updatedAt           DateTime            @updatedAt @map("updated_at")
  updatedBy           String?             @map("updated_by") @db.Uuid

  workflowInstance WorkflowInstance @relation(fields: [workflowInstanceId], references: [id], onDelete: Cascade)
  workflowStep     WorkflowStep     @relation(fields: [workflowStepId], references: [id])
  assignee         User             @relation(fields: [assignedTo], references: [id])

  @@index([workflowInstanceId, status])
  @@index([assignedTo, status])
  @@map("workflow_step_assignments")
}

model WorkflowStepHistory {
  id                   String             @id @default(uuid()) @db.Uuid
  workflowInstanceId   String             @map("workflow_instance_id") @db.Uuid
  workflowStepId       String             @map("workflow_step_id") @db.Uuid
  action               String             @db.VarChar(50) // APPROVED, REJECTED, SKIPPED, COMMENT
  actedBy              String             @map("acted_by") @db.Uuid
  remarks              String?            @db.Text
  createdAt            DateTime           @default(now()) @map("created_at")

  workflowInstance WorkflowInstance @relation(fields: [workflowInstanceId], references: [id], onDelete: Cascade)
  workflowStep     WorkflowStep     @relation(fields: [workflowStepId], references: [id])

  @@index([workflowInstanceId])
  @@map("workflow_step_history")
}

// ─── MESSAGES & NOTIFICATIONS ────────────────────────────────────────────────

model MessageTemplate {
  id          String        @id @default(uuid()) @db.Uuid
  code        String        @unique @db.VarChar(100)
  name        String        @db.VarChar(200)
  channel     MessageChannel
  subject     String?       @db.VarChar(500) // for email
  body        String        @db.Text // template with {{mergeField}} placeholders
  mergeFields Json?         @map("merge_fields") // documented list of available fields
  isActive    Boolean       @default(true) @map("is_active")
  createdAt   DateTime      @default(now()) @map("created_at")
  createdBy   String?       @map("created_by") @db.Uuid
  updatedAt   DateTime      @updatedAt @map("updated_at")
  updatedBy   String?       @map("updated_by") @db.Uuid

  logs MessageLog[]

  @@index([channel, isActive])
  @@map("message_templates")
}

model MessageLog {
  id            String        @id @default(uuid()) @db.Uuid
  templateId    String?       @map("template_id") @db.Uuid
  channel       MessageChannel
  recipientId   String?       @map("recipient_id") @db.Uuid // party or user id
  recipientType String?       @map("recipient_type") @db.VarChar(50)
  recipientAddr String        @map("recipient_addr") @db.VarChar(500) // email/phone
  subject       String?       @db.VarChar(500)
  body          String        @db.Text
  status        MessageStatus @default(QUEUED)
  errorMessage  String?       @map("error_message") @db.Text
  sentAt        DateTime?     @map("sent_at")
  providerRef   String?       @map("provider_ref") @db.VarChar(500)
  sentById      String?       @map("sent_by_id") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at")
  createdBy     String?       @map("created_by") @db.Uuid
  updatedAt     DateTime      @updatedAt @map("updated_at")
  updatedBy     String?       @map("updated_by") @db.Uuid

  template    MessageTemplate? @relation(fields: [templateId], references: [id])
  sender      User?            @relation("MessageSender", fields: [sentById], references: [id])
  recipientParty Party?        @relation("MessageRecipient", fields: [recipientId], references: [id])

  @@index([templateId])
  @@index([channel, status])
  @@index([recipientId])
  @@index([createdAt])
  @@map("message_logs")
}

model Notification {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  type        NotificationType
  title       String           @db.VarChar(300)
  body        String           @db.Text
  status      NotificationStatus @default(UNREAD)
  link        String?          @db.VarChar(500)
  metadata    Json?
  expiresAt   DateTime?        @map("expires_at")
  createdAt   DateTime         @default(now()) @map("created_at")

  @@index([userId, status])
  @@index([userId, createdAt])
  @@map("notifications")
}

model Announcement {
  id          String           @id @default(uuid()) @db.Uuid
  title       String           @db.VarChar(300)
  body        String           @db.Text
  scope       AnnouncementScope @default(ALL)
  branchCode  String?          @map("branch_code") @db.VarChar(20)
  roleIds     Json?            @map("role_ids") // array of role UUIDs
  userIds     Json?            @map("user_ids") // array of user UUIDs
  isActive    Boolean          @default(true) @map("is_active")
  startsAt    DateTime?        @map("starts_at")
  endsAt      DateTime?        @map("ends_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  createdBy   String?          @map("created_by") @db.Uuid
  updatedAt   DateTime         @updatedAt @map("updated_at")
  updatedBy   String?          @map("updated_by") @db.Uuid

  branch Branch? @relation(fields: [branchCode], references: [code])

  @@index([scope, isActive])
  @@index([branchCode])
  @@map("announcements")
}

// ─── LEDGER SNAPSHOTS ────────────────────────────────────────────────────────

model LedgerSnapshot {
  id            String   @id @default(uuid()) @db.Uuid
  partyId       String   @map("party_id") @db.Uuid
  year          Int
  month         Int
  openingBalance Decimal @map("opening_balance") @db.Decimal(18, 2)
  totalDebit   Decimal  @map("total_debit") @db.Decimal(18, 2) @default(0)
  totalCredit  Decimal  @map("total_credit") @db.Decimal(18, 2) @default(0)
  closingBalance Decimal @map("closing_balance") @db.Decimal(18, 2)
  lineItems    Json?    // detailed line items as jsonb
  rowVersion   Int      @default(1) @map("row_version")
  createdAt    DateTime @default(now()) @map("created_at")
  createdBy    String?  @map("created_by") @db.Uuid
  updatedAt    DateTime @updatedAt @map("updated_at")
  updatedBy    String?  @map("updated_by") @db.Uuid

  party Party @relation(fields: [partyId], references: [id])

  @@unique([partyId, year, month])
  @@index([partyId])
  @@index([year, month])
  @@map("ledger_snapshots")
}

// ─── IMPORT TEMPLATES (for generic import framework) ─────────────────────────

model ImportTemplate {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @db.VarChar(200)
  sourceType      String   @map("source_type") @db.VarChar(50)
  columnMappings  Json     @map("column_mappings") // [{sourceCol, targetField, required, transform}]
  validationRules Json?    @map("validation_rules") // [{field, rule, params}]
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  createdBy       String?  @map("created_by") @db.Uuid
  updatedAt       DateTime @updatedAt @map("updated_at")
  updatedBy       String?  @map("updated_by") @db.Uuid

  importLogs      ImportLog[]

  @@index([sourceType])
  @@map("import_templates")
}

model ImportLog {
  id            String       @id @default(uuid()) @db.Uuid
  batchId       String       @unique @map("batch_id") @db.Uuid
  sourceType    String       @map("source_type") @db.VarChar(50)
  templateId    String?      @map("template_id") @db.Uuid
  fileName      String       @map("file_name") @db.VarChar(500)
  totalRows     Int          @map("total_rows")
  validRows     Int          @map("valid_rows") @default(0)
  invalidRows   Int          @map("invalid_rows") @default(0)
  committedRows Int          @map("committed_rows") @default(0)
  status        ImportStatus
  errorMessage  String?      @map("error_message") @db.Text
  committedAt   DateTime?    @map("committed_at")
  rolledBackAt  DateTime?    @map("rolled_back_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  createdBy     String?      @map("created_by") @db.Uuid
  updatedAt     DateTime     @updatedAt @map("updated_at")
  updatedBy     String?     @map("updated_by") @db.Uuid

  template ImportTemplate? @relation(fields: [templateId], references: [id])
  records RawStagingRecord[]

  @@index([sourceType, status])
  @@index([createdBy, createdAt])
  @@map("import_logs")
}

// ─── AUDIT LOG (single generic table) ────────────────────────────────────────

model AuditLog {
