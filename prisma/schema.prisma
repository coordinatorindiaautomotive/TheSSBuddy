  committedBy          String?  @map("committed_by") @db.VarChar(200)
  reopenedAt           DateTime? @map("reopened_at")
  reopenedBy           String?  @map("reopened_by") @db.VarChar(200)
  reopenReason         String?  @map("reopen_reason") @db.Text
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@unique([year, month], name: "year_month_governor_unique")
  @@index([status])
  @@map("incentive_governor_period_controls")
}

model IncentiveRegisterRecord {
  id                String   @id @default(uuid()) @db.Uuid
  governorBatchId   String   @map("governor_batch_id") @db.VarChar(100)
  year              Int
  month             Int
  monthName         String?  @map("month_name") @db.VarChar(50)
  originalPartyCode String   @map("original_party_code") @db.VarChar(100) // Original Party Code SSOT
  partyName         String   @map("party_name") @db.VarChar(300)
  baseBranch        String   @map("base_branch") @db.VarChar(50) // Party Master Base Branch
  partyType         String   @map("party_type") @db.VarChar(100) // Party Master Party Type
  nrs               Float    @default(0) // Net Retail Selling aggregated from RAW
  totalDiscount     Float    @default(0) @map("total_discount") // Discount aggregated from RAW
  incentiveType     String   @default("Fixed") @map("incentive_type") @db.VarChar(50) // Fixed / Slab-Based
  applicableRate    Float?   @map("applicable_rate")
  applicableSlab    String?  @map("applicable_slab") @db.VarChar(150)
  grossIncentive    Float    @default(0) @map("gross_incentive")
  finalIncentive    Float    @default(0) @map("final_incentive") // MAX(grossIncentive - totalDiscount, 0)
  processingMethod  String   @default("DYNAMIC") @map("processing_method") @db.VarChar(50) // DYNAMIC / PRE_CALCULATED
  validationStatus  String   @default("VALID") @map("validation_status") @db.VarChar(50) // VALID, WARNING, ERROR
  validationErrors  Json?    @map("validation_errors")
  status            String   @default("DRAFT") @db.VarChar(50) // DRAFT, COMMITTED, REVERSED
  createdBy         String?  @map("created_by") @db.VarChar(200)
  createdAt         DateTime @default(now()) @map("created_at")

  // Bank Payout Transfer Fields
  payoutStatus      String?  @map("payout_status") @db.VarChar(50)   // Success, Paid, Reversed, Failed
  transferredAmount Float?   @map("transferred_amount")               // Column H: Amount
  transferDate      String?  @map("transfer_date") @db.VarChar(50)   // Column N: Pymt_Date
  accountHolder     String?  @map("account_holder") @db.VarChar(200)  // Column E: Beneficiary Name
  accountNo         String?  @map("account_no") @db.VarChar(100)      // Column F: Beneficiary Account No
  ifscCode          String?  @map("ifsc_code") @db.VarChar(50)        // Column G: Bene_IFSC_Code
  utrNo             String?  @map("utr_no") @db.VarChar(100)          // Column AC: UTR NO
  payoutBatchId     String?  @map("payout_batch_id") @db.VarChar(100) // Upload batch ID

  @@index([year, month, processingMethod])
  @@index([originalPartyCode])
  @@index([baseBranch])
  @@index([governorBatchId])
  @@index([payoutStatus])
  @@map("incentive_register_records")
}

model IncentiveGovernorAuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  batchId     String?  @map("batch_id") @db.VarChar(100)
  year        Int
  month       Int
  action      String   @db.VarChar(100) // CONFIG_SAVED, CALCULATION_EXECUTED, PREVIEW_GENERATED, EXCEL_UPLOADED, COMMITTED, PERIOD_LOCKED, PERIOD_REOPENED
  performedBy String   @map("performed_by") @db.VarChar(200)
  details     Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([year, month])
  @@index([action])
  @@map("incentive_governor_audit_logs")
}

