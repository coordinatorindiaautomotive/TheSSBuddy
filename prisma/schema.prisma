// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ────────────────────────────────────────────────────────────────────

enum PeriodModuleType {
  INCENTIVE
  CASH
  MONTH
}

enum PeriodStatus {
  OPEN
  LOCKED
  CLOSED
}

enum RuleType {
  INCENTIVE_SLAB
  TDS_DEDUCTION
  OUTSTANDING_AGING
}

enum RuleConditionOperator {
  EQ
  NEQ
  GT
  GTE
  LT
  LTE
  IN
  NOT_IN
  BETWEEN
  LIKE
  IS_NULL
  IS_NOT_NULL
}

enum RuleActionType {
  SET_VALUE
  MULTIPLY
  ADD
  SUBTRACT
  APPLY_FORMULA
  SET_FLAG
}

enum RuleVersionStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum WorkflowEntityType {
  INCENTIVE_RECORD
  CASH_RECONCILIATION
  EXTERNAL_INCENTIVE_UPLOAD
  GENERAL
}

enum WorkflowStepType {
  APPROVAL
  NOTIFICATION
  CONDITIONAL
}

enum WorkflowStepStatus {
  PENDING
  APPROVED
  REJECTED
  SKIPPED
  IN_PROGRESS
}

enum WorkflowInstanceStatus {
  IN_PROGRESS
  APPROVED
  REJECTED
  CANCELLED
}

enum MessageChannel {
  EMAIL
  SMS
  IN_APP
}

enum MessageStatus {
  PENDING
  SENT
  FAILED
  QUEUED
}

enum NotificationType {
  SYSTEM
  ANNOUNCEMENT
  TASK
  ALERT
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

enum ImportStatus {
  STAGING
  VALIDATED
  COMMITTED
  ROLLED_BACK
  FAILED
}

enum PartyType {
  DEALER
  CUSTOMER
  CONSIGNEE
}

enum PartySubType {
  REGULAR
  PREMIUM
  TEMPORARY
  DORMANT
  RO
  MW
  AW
}

enum MappingType {
  EXECUTIVE_ASSIGNMENT
  BRANCH_ASSOCIATION
  CODE_ALTERNATE
  CATEGORY_MAPPING
}

enum CashTransactionType {
  CASH_IN
  CASH_OUT
}

enum ReconciliationStatus {
  UNRECONCILED
  RECONCILED
  EXCEPTION
}

enum IncentiveRecordType {
  CALCULATED
  MANUALLY_UPLOADED
  OVERRIDE
}

enum IncentiveRecordStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  POSTED
}

enum AnnouncementScope {
  ALL
  BRANCH
  ROLE
  USER
}

// ─── CORE: USERS, ROLES, PERMISSIONS ─────────────────────────────────────────

model User {
  id              String    @id @default(uuid()) @db.Uuid
  username        String    @unique @db.VarChar(100)
  email           String?   @unique @db.VarChar(255)
  phone           String?   @db.VarChar(20)
  passwordHash    String    @map("password_hash") @db.VarChar(255)
  fullName        String    @map("full_name") @db.VarChar(200)
  isActive        Boolean   @default(true) @map("is_active")
  lastLoginAt     DateTime? @map("last_login_at")
  refreshToken    String?   @map("refresh_token") @db.VarChar(500)
  refreshTokenExp DateTime? @map("refresh_token_exp")
  createdAt       DateTime  @default(now()) @map("created_at")
  createdBy       String?   @map("created_by") @db.Uuid
  updatedAt       DateTime  @updatedAt @map("updated_at")
  updatedBy       String?   @map("updated_by") @db.Uuid

  roles              UserRole[]
  branchAccesses     UserBranchAccess[]
  sentMessages       MessageLog[]           @relation("MessageSender")
  workflowAssignments WorkflowStepAssignment[]
  auditLogsCreated   AuditLog[]             @relation("AuditCreator")
  periodLocks        PeriodLock[]           @relation("PeriodLocker")
  incentiveOverrides IncentiveRecord[]      @relation("OverrideBy")

  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(100)
  description String?  @db.Text
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  createdBy   String?  @map("created_by") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedBy   String?  @map("updated_by") @db.Uuid

  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(150)
  name        String   @db.VarChar(200)
  module      String   @db.VarChar(100)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  createdBy   String?  @map("created_by") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedBy   String?  @map("updated_by") @db.Uuid

  @@map("permissions")
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role    Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now()) @map("assigned_at")
  assignedBy String?  @map("assigned_by") @db.Uuid

  @@id([userId, roleId])
  @@map("user_roles")
}

model UserBranchAccess {
  userId     String @db.Uuid
  branchCode String @db.VarChar(20)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchCode], references: [code])

  grantedAt DateTime @default(now()) @map("granted_at")
  grantedBy String?  @map("granted_by") @db.Uuid
  isDefault Boolean  @default(false) @map("is_default")

  @@id([userId, branchCode])
  @@map("user_branch_access")
}

// ─── BRANCHES ────────────────────────────────────────────────────────────────

model Branch {
  code        String   @id @db.VarChar(20)
  name        String   @db.VarChar(200)
  region      String?  @db.VarChar(100)
  address     String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  
  type               String?   @db.VarChar(50)
  consignee          String?   @db.VarChar(50)
  incharge           String?   @db.VarChar(200)
  phone              String?   @db.VarChar(50)
  email              String?   @db.VarChar(200)
  area               String?   @db.VarChar(50)
  coordinates        String?   @db.Text
  latitude           String?   @db.VarChar(50)
  longitude          String?   @db.VarChar(50)
  openingDate        DateTime? @map("opening_date")
  allowedCategories  String?   @db.Text
  allowedPartyTypes  String?   @db.Text

  createdAt   DateTime @default(now()) @map("created_at")
  createdBy   String?  @map("created_by") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedBy   String?  @map("updated_by") @db.Uuid

  users           UserBranchAccess[]
  parties         Party[]
  periodLocks     PeriodLock[]
  incentiveSchemes IncentiveScheme[]
  incentiveRecords IncentiveRecord[]
  cashTransactions CashTransaction[]
  dealerTargets    DealerTarget[]
  dealerPerformances DealerMonthlyPerformance[]
  announcements    Announcement[]

  @@map("branches")
}

// ─── PARTIES ─────────────────────────────────────────────────────────────────

model Party {
  id            String     @id @default(uuid()) @db.Uuid
  code          String     @unique @db.VarChar(50)
  name          String     @db.VarChar(300)
  type          PartyType
  subType       PartySubType @default(REGULAR) @map("sub_type")
  primaryBranchCode String?  @map("primary_branch_code") @db.VarChar(20)
  pan           String?    @db.VarChar(20)
  gstIn         String?    @map("gst_in") @db.VarChar(20)
  contactPerson String?    @map("contact_person") @db.VarChar(200)
  phone         String?    @db.VarChar(20)
  email         String?    @db.VarChar(255)
  address       String?    @db.Text
  city          String?    @db.VarChar(100)
  state         String?    @db.VarChar(100)
  pincode       String?    @db.VarChar(10)
  isActive      Boolean    @default(true) @map("is_active")
  rowVersion    Int        @default(1) @map("row_version")
  createdAt     DateTime   @default(now()) @map("created_at")
  createdBy     String?    @map("created_by") @db.Uuid
  updatedAt     DateTime   @updatedAt @map("updated_at")
  updatedBy     String?    @map("updated_by") @db.Uuid

  primaryBranch    Branch?             @relation(fields: [primaryBranchCode], references: [code])
  mappings         PartyMapping[]
  bankDetails      PartyBankDetail[]
  incentiveRecords IncentiveRecord[]
  dealerTargets    DealerTarget[]
  dealerPerformances DealerMonthlyPerformance[]
  cashTransactions CashTransaction[]
  ledgerSnapshots  LedgerSnapshot[]
  receivedMessages MessageLog[]         @relation("MessageRecipient")

  @@index([primaryBranchCode])
  @@index([type, subType])
  @@index([code, primaryBranchCode])
  @@map("parties")
}

model PartyMapping {
  id           String      @id @default(uuid()) @db.Uuid
  partyId      String      @db.Uuid
  mappingType  MappingType @map("mapping_type")
  mappedValue  String      @map("mapped_value") @db.VarChar(200)
  mappedLabel  String?     @map("mapped_label") @db.VarChar(300)
  effectiveFrom DateTime?  @map("effective_from")
  effectiveTo   DateTime?  @map("effective_to")
  isActive     Boolean     @default(true) @map("is_active")
  createdAt    DateTime    @default(now()) @map("created_at")
  createdBy    String?     @map("created_by") @db.Uuid
  updatedAt    DateTime    @updatedAt @map("updated_at")
  updatedBy    String?     @map("updated_by") @db.Uuid

  party Party @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@index([partyId, mappingType])
  @@index([mappingType, mappedValue])
  @@map("party_mapping")
}

model PartyBankDetail {
  id            String   @id @default(uuid()) @db.Uuid
  partyId       String   @db.Uuid
  bankName      String   @map("bank_name") @db.VarChar(200)
  branchName    String?  @map("branch_name") @db.VarChar(200)
  accountNumber String   @map("account_number") @db.VarChar(50)
  ifscCode      String?  @map("ifsc_code") @db.VarChar(20)
  accountType   String?  @map("account_type") @db.VarChar(30)
  accountHolder String?  @map("account_holder") @db.VarChar(200)
  isDefault     Boolean  @default(false) @map("is_default")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  createdBy     String?  @map("created_by") @db.Uuid
  updatedAt     DateTime @updatedAt @map("updated_at")
  updatedBy     String?  @map("updated_by") @db.Uuid

  party Party @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@index([partyId])
  @@map("party_bank_details")
}

// ─── PARTY MASTER (CONSOLIDATED SSOT TABLE) ──────────────────────────────────
// Single table holding all party info. Synced from raw_sales, manual fields
// (executive, bank, original_code etc.) are preserved across syncs.

model PartyMaster {
  id              String    @id @default(uuid()) @db.Uuid

  // Core identity — sourced from raw_sales cons_party_code (unique)
  consPartyCode   String    @unique @map("cons_party_code") @db.VarChar(50)
  consPartyName   String    @map("cons_party_name") @db.VarChar(300)
  partyType       String?   @map("party_type") @db.VarChar(100)  // INDEPENDENT WORKSHOP, CO-DEALER, etc.

  // Base location — derived from raw_sales (loc with max net_retail_selling)
  baseLoc         String?   @map("base_loc") @db.VarChar(20)
  totalSales      Decimal   @default(0) @map("total_sales") @db.Decimal(18, 2)

  // Alternate / original code mapping (manual)
  originalCode    String?   @map("original_code") @db.VarChar(50)

  // Contact (manual)
  phone           String?   @db.VarChar(20)
  pan             String?   @db.VarChar(20)
  gstIn           String?   @map("gst_in") @db.VarChar(20)

  // Sales executive (manual assignment)
  salesExecutive  String?   @map("sales_executive") @db.VarChar(100)

  // Bank details (manual — same as PartyBankDetail but denormalised here for speed)
  bankName        String?   @map("bank_name") @db.VarChar(200)
  bankBranch      String?   @map("bank_branch") @db.VarChar(200)
  accountNumber   String?   @map("account_number") @db.VarChar(50)
  ifscCode        String?   @map("ifsc_code") @db.VarChar(20)
  accountHolder   String?   @map("account_holder") @db.VarChar(200)

  // Incentive settings (manual)
  incentiveType   String    @default("Slab-Based") @map("incentive_type") @db.VarChar(50)
  incentiveRule   String?   @map("incentive_rule") @db.VarChar(100)

  // Status
  isActive        Boolean   @default(true) @map("is_active")
  lastSyncedAt    DateTime? @map("last_synced_at")

  // Audit
  createdAt       DateTime  @default(now()) @map("created_at")
  createdBy       String?   @map("created_by") @db.Uuid
  updatedAt       DateTime  @updatedAt @map("updated_at")
  updatedBy       String?   @map("updated_by") @db.Uuid

  @@index([consPartyCode])
  @@index([baseLoc])
  @@index([partyType])
  @@index([salesExecutive])
  @@index([isActive])
  @@map("party_master")
}

// ─── PERIOD LOCKS ────────────────────────────────────────────────────────────

model PeriodLock {
  id               String            @id @default(uuid()) @db.Uuid
  moduleType       PeriodModuleType  @map("module_type")
  year             Int
  month            Int
  branchCode       String?           @map("branch_code") @db.VarChar(20)
  partCategoryCode String?           @map("part_category_code") @db.VarChar(50)
  incentiveSource  String?           @map("incentive_source") @db.VarChar(50)
  status           PeriodStatus
  lockedBy         String?           @map("locked_by") @db.Uuid
  lockedDate       DateTime?         @map("locked_date")
  postedBy         String?           @map("posted_by") @db.Uuid
  postedDate       DateTime?         @map("posted_date")
  closedAt         DateTime?         @map("closed_at")
  closedBy         String?           @map("closed_by") @db.Uuid
  unlockReason     String?           @map("unlock_reason") @db.VarChar(200)
  unlockRemarks    String?           @map("unlock_remarks") @db.Text
  createdAt        DateTime          @default(now()) @map("created_at")
  createdBy        String?           @map("created_by") @db.Uuid
  updatedAt        DateTime          @updatedAt @map("updated_at")
  updatedBy        String?           @map("updated_by") @db.Uuid

  branch Branch? @relation(fields: [branchCode], references: [code])
  locker User?   @relation("PeriodLocker", fields: [lockedBy], references: [id])

  @@unique([moduleType, year, month, branchCode, partCategoryCode, incentiveSource])
  @@index([moduleType, year, month])
  @@index([branchCode, year, month])
  @@map("period_locks")
}

// ─── RULE ENGINE ─────────────────────────────────────────────────────────────

model RuleMaster {
  id          String            @id @default(uuid()) @db.Uuid
  code        String            @unique @db.VarChar(100)
  name        String            @db.VarChar(300)
  ruleType    RuleType          @map("rule_type")
  description String?           @db.Text
  isActive    Boolean           @default(true) @map("is_active")
  createdAt   DateTime          @default(now()) @map("created_at")
  createdBy   String?           @map("created_by") @db.Uuid
  updatedAt   DateTime          @updatedAt @map("updated_at")
  updatedBy   String?           @map("updated_by") @db.Uuid

  @@index([ruleType])
  @@map("rule_master")
}

// ─── INCENTIVE SCHEMES ───────────────────────────────────────────────────────

model IncentiveScheme {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(100)
  name        String   @db.VarChar(300)
  description String?  @db.Text
  source      String   @db.VarChar(50) // internal, external, etc.
  effectiveFrom DateTime @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")
  isActive    Boolean  @default(true) @map("is_active")
  branchCode  String?  @map("branch_code") @db.VarChar(20) // null = all branches
  createdAt   DateTime @default(now()) @map("created_at")
  createdBy   String?  @map("created_by") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedBy   String?  @map("updated_by") @db.Uuid

  branch  Branch?               @relation(fields: [branchCode], references: [code])
  details IncentiveSchemeDetail[]
  records IncentiveRecord[]

  @@index([branchCode, isActive])
  @@map("incentive_schemes")
}

model IncentiveSchemeDetail {
  id               String   @id @default(uuid()) @db.Uuid
  incentiveSchemeId String  @map("incentive_scheme_id") @db.Uuid
  locationType     String?  @map("location_type") @db.VarChar(50)
  partCategoryCode String?  @map("part_category_code") @db.VarChar(50)
  partyType        PartyType @map("party_type")
  slabFrom         Decimal  @map("slab_from") @db.Decimal(18, 2)
  slabTo           Decimal? @map("slab_to") @db.Decimal(18, 2)
  incentiveRate    Decimal  @map("incentive_rate") @db.Decimal(10, 4)
  incentiveType    String   @default("PERCENTAGE") @map("incentive_type") @db.VarChar(30) // PERCENTAGE, FLAT, TIERED
  minAmount        Decimal? @map("min_amount") @db.Decimal(18, 2)
  maxAmount        Decimal? @map("max_amount") @db.Decimal(18, 2)
  sortOrder        Int      @default(0) @map("sort_order")
  createdAt        DateTime @default(now()) @map("created_at")
  createdBy        String?  @map("created_by") @db.Uuid
  updatedAt        DateTime @updatedAt @map("updated_at")
  updatedBy        String?  @map("updated_by") @db.Uuid

  incentiveScheme IncentiveScheme @relation(fields: [incentiveSchemeId], references: [id], onDelete: Cascade)

  @@index([incentiveSchemeId])
  @@index([partyType, partCategoryCode])
  @@map("incentive_scheme_detail")
}

model IncentiveRecord {
  id                String              @id @default(uuid()) @db.Uuid
  partyId           String              @db.Uuid
  schemeId          String?             @map("scheme_id") @db.Uuid
  year              Int
  month             Int
  branchCode        String              @map("branch_code") @db.VarChar(20)
  partCategoryCode  String?             @map("part_category_code") @db.VarChar(50)
  incentiveSource   String?             @map("incentive_source") @db.VarChar(50)
  recordType        IncentiveRecordType @default(CALCULATED) @map("record_type")
  status            IncentiveRecordStatus @default(DRAFT)
  baseAmount        Decimal             @map("base_amount") @db.Decimal(18, 2)
  incentiveRate     Decimal?            @map("incentive_rate") @db.Decimal(10, 4)
  calculatedAmount  Decimal             @map("calculated_amount") @db.Decimal(18, 2)
  tdsAmount         Decimal             @default(0) @map("tds_amount") @db.Decimal(18, 2)
  netAmount         Decimal             @map("net_amount") @db.Decimal(18, 2)
  overrideRemarks   String?             @map("override_remarks") @db.Text
  overriddenById    String?             @map("overridden_by_id") @db.Uuid
  rowVersion        Int                 @default(1) @map("row_version")
  createdAt         DateTime            @default(now()) @map("created_at")
  createdBy         String?             @map("created_by") @db.Uuid
  updatedAt         DateTime            @updatedAt @map("updated_at")
  updatedBy         String?             @map("updated_by") @db.Uuid

  party       Party              @relation(fields: [partyId], references: [id])
  scheme      IncentiveScheme?   @relation(fields: [schemeId], references: [id])
  branch      Branch             @relation(fields: [branchCode], references: [code])
  overriddenBy User?              @relation("OverrideBy", fields: [overriddenById], references: [id])
  workflowInstances WorkflowInstance[]

  @@index([partyId, year, month])
  @@index([branchCode, year, month])
  @@index([branchCode, status, year, month])
  @@index([schemeId, year, month])
  @@index([status, year, month])
  @@map("incentive_records")
}

// ─── DEALER TARGETS & PERFORMANCE ────────────────────────────────────────────

model DealerTarget {
  id                    String   @id @default(uuid()) @db.Uuid
  partyId               String   @map("party_id") @db.Uuid
  partyCode             String   @default("") @map("party_code") @db.VarChar(100)
  partyName             String?  @map("party_name") @db.VarChar(255)
  branchCode            String   @map("branch_code") @db.VarChar(50)
  year                  Int
  month                 Int
  partCategoryCode      String?  @map("part_category_code") @db.VarChar(50)
  systemSuggestedTarget Decimal  @default(0) @map("system_suggested_target") @db.Decimal(18, 2)
  adminDefinedTarget    Decimal? @map("admin_defined_target") @db.Decimal(18, 2)
  finalTarget           Decimal  @default(0) @map("final_target") @db.Decimal(18, 2)
  targetAmount          Decimal  @default(0) @map("target_amount") @db.Decimal(18, 2)
  targetQuantity        Int?     @map("target_quantity")
  remarks               String?  @db.Text
  rowVersion            Int      @default(1) @map("row_version")
  createdAt             DateTime @default(now()) @map("created_at")
  createdBy             String?  @map("created_by") @db.Uuid
  updatedAt             DateTime @updatedAt @map("updated_at")
  updatedBy             String?  @map("updated_by") @db.Uuid

  party  Party   @relation(fields: [partyId], references: [id])
  branch Branch? @relation(fields: [branchCode], references: [code])

  @@unique([partyCode, branchCode, year, month, partCategoryCode], name: "party_branch_period_unique")
  @@index([branchCode, year, month])
  @@index([partyCode])
  @@map("dealer_targets")
}

// ─── TARGET VS ACHIEVEMENT PRE-AGGREGATED PERFORMANCE CACHE ─────────────────

model TargetVsAchievementSnapshot {
  id                    String   @id @default(uuid()) @db.Uuid
  fiscalYear            Int      @map("fiscal_year")
  month                 String   @db.VarChar(20)
  monthNum              Int      @map("month_num")
  branchCode            String   @map("branch_code") @db.VarChar(50)
  branchName            String?  @map("branch_name") @db.VarChar(255)
  partyCode             String   @map("party_code") @db.VarChar(100)
  partyName             String   @map("party_name") @db.VarChar(255)
  partyType             String?  @map("party_type") @db.VarChar(100)
  partCategoryCode      String?  @map("part_category_code") @db.VarChar(50)
  salesExecutive        String?  @map("sales_executive") @db.VarChar(255)
  
  // Historical Baseline Components
  lySameMonthSales      Decimal  @default(0) @map("ly_same_month_sales") @db.Decimal(18, 2)
  lastMonthSales        Decimal  @default(0) @map("last_month_sales") @db.Decimal(18, 2)
  lastQuarterAvg        Decimal  @default(0) @map("last_quarter_avg") @db.Decimal(18, 2)
  lastFyAvg             Decimal  @default(0) @map("last_fy_avg") @db.Decimal(18, 2)
  avgSaleLast6Month     Decimal  @default(0) @map("avg_sale_last_6_month") @db.Decimal(18, 2)

  // Target Engine Output
  weightedBase          Decimal  @default(0) @map("weighted_base") @db.Decimal(18, 2)
  recommendedTarget     Decimal  @default(0) @map("recommended_target") @db.Decimal(18, 2)
  gapAdjustment         Decimal  @default(0) @map("gap_adjustment") @db.Decimal(18, 2)
  systemSuggestedTarget Decimal  @default(0) @map("system_suggested_target") @db.Decimal(18, 2)
  adminDefinedTarget    Decimal? @map("admin_defined_target") @db.Decimal(18, 2)
  finalTarget           Decimal  @default(0) @map("final_target") @db.Decimal(18, 2)

  // Actual Performance & Growth
  currentSales          Decimal  @default(0) @map("current_sales") @db.Decimal(18, 2)
  achievementPercent    Decimal  @default(0) @map("achievement_percent") @db.Decimal(10, 2)
  ytdSales              Decimal  @default(0) @map("ytd_sales") @db.Decimal(18, 2)
  lastYearYTDSales      Decimal  @default(0) @map("last_year_ytd_sales") @db.Decimal(18, 2)
  yoyGrowthPercent      Decimal  @default(0) @map("yoy_growth_percent") @db.Decimal(10, 2)
  
  // Workflow Status
  targetStatus          String   @default("DRAFT") @map("target_status") @db.VarChar(50) // DRAFT, REVIEWED, APPROVED, LOCKED
  lockedAt              DateTime? @map("locked_at")
  lockedBy              String?   @map("locked_by") @db.VarChar(100)
  calculatedAt          DateTime @default(now()) @map("calculated_at")

  @@unique([fiscalYear, month, branchCode, partyCode, partCategoryCode], name: "target_achievement_snapshot_unique")
  @@index([fiscalYear, month])
  @@index([branchCode, fiscalYear, month])
  @@index([partyCode, fiscalYear, monthNum])
  @@index([salesExecutive, fiscalYear, monthNum])
  @@index([partyType])
  @@index([targetStatus])
  @@map("target_vs_achievement_snapshots")
}

model DealerMonthlyPerformance {
