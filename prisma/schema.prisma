  @@map("asset_allocations")
}

model AssetMaintenanceLog {
  id          String   @id @default(uuid()) @db.Uuid
  assetId     String   @map("asset_id") @db.Uuid
  type        String   @default("REPAIR") @db.VarChar(50) // REPAIR, SERVICE, INSPECTION, UPGRADE
