  year                 Int
  month                Int
  monthName            String   @map("month_name") @db.VarChar(50)
  processingMethod     String   @default("DYNAMIC") @map("processing_method") @db.VarChar(50) // DYNAMIC, PRE_CALCULATED
  status               String   @default("NOT_PROCESSED") @db.VarChar(50) // NOT_PROCESSED, DRAFT, PREVIEW, COMMITTED, LOCKED, REOPENED, CANCELLED
  governorRules        Json?    @map("governor_rules") // array of { branch, categories, partyTypes }
  batchId              String?  @map("batch_id") @db.VarChar(100)
  totalEligibleParties Int      @default(0) @map("total_eligible_parties")
  totalNrs             Float    @default(0) @map("total_nrs")
  totalDiscount        Float    @default(0) @map("total_discount")
  grossIncentive       Float    @default(0) @map("gross_incentive")
  finalIncentive       Float    @default(0) @map("final_incentive")
