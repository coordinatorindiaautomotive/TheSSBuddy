# .env.example
# Copy this file to .env on your server and fill in the values

# ─── Database ───────────────────────────────────────────────────────
DATABASE_URL=postgresql://USERNAME:PASSWORD@localhost:5432/thessbuddy?schema=public

# ─── Redis (set USE_MOCK_REDIS=true if no Redis server available) ────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
USE_MOCK_REDIS=true

# ─── JWT Auth ────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=REPLACE_WITH_SECURE_RANDOM_STRING_MIN_32_CHARS
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_SECURE_RANDOM_STRING_MIN_32_CHARS
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── Application ─────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ─── File Uploads ────────────────────────────────────────────────────
UPLOAD_DEST=./uploads
MAX_FILE_SIZE=10485760

# ─── SMTP (Email notifications) ──────────────────────────────────────
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=no-reply@yourdomain.com
SMTP_PASS=YOUR_SMTP_PASSWORD
SMTP_FROM=no-reply@yourdomain.com

# ─── SMS - Msg91 (optional) ──────────────────────────────────────────
MSG91_AUTH_KEY=
MSG91_SENDER=

# ─── Tally ERP Integration ───────────────────────────────────────────
TALLY_URL=http://127.0.0.1:9000/
